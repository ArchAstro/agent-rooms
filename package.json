{
  "name": "@archastro/agent-rooms",
  "version": "0.3.0",
  "description": "Agent Rooms: an auditable stdlib-only Python kit that lets coding agents publish to a shared team room and local PR evidence artifacts. Install with npx skills.",
  "bin": {
    "agent-rooms": "bin/install.mjs"
  },
  "files": [
    "bin",
    "skills/team-room/*.py",
    "skills/team-room/*.md",
    "skills/team-room/*.yaml",
    "skills/team-room/evidence/**/*.py",
    "skills/team-room/evidence/**/*.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArchAstro/agent-rooms.git"
  },
  "license": "UNLICENSED"
}
